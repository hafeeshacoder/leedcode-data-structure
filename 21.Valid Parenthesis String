class Solution {
    public boolean checkValidString(String s) {
        
        int low = 0;   // minimum open brackets
        int high = 0;  // maximum open brackets
        
        for(char ch : s.toCharArray()) {
            
            if(ch == '(') {
                low++;
                high++;
            }
            else if(ch == ')') {
                if(low > 0) low--;
                high--;
            }
            else {  // if '*'
                if(low > 0) low--;  // treat as ')'
                high++;             // treat as '('
            }
            
            if(high < 0) return false;
        }
        
        return low == 0;
    }
}
